{
  "name": "@pinchpass/cli",
  "version": "1.2.0",
  "description": "One-time E2E-encrypted secret request links — native for Pi and OpenClaw agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubybear-lgtm/PinchPass.git"
  },
  "keywords": [
    "pi-package",
    "pinchpass",
    "secrets",
    "api-key",
    "e2e-encryption",
    "openclaw"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "scripts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/rubybear-lgtm/PinchPass/master/pinchpass.png"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc && node scripts/copy-skill.js",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "postinstall": "node scripts/install-binary.js",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@opencode-ai/plugin": "^1.16.2",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@opencode-ai/plugin": "^1.19.0",
    "typebox": "^1.3.37",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
